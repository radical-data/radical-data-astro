---
import Card from "~/components/Card.astro";
import Layout from "../layouts/Layout.astro";
const response = await fetch(
  `https://api.airtable.com/v0/${import.meta.env.DB_ID}/Link Page`,
  {
    headers: {
      Authorization: `Bearer ${import.meta.env.DB_TOKEN}`,
    },
  }
);
const data = await response.json();
---

<Layout title="Links | Radical Data">
  <main class="page-shell">
    <section class="wrapper page-shell__hero">
      <p class="page-shell__kicker">Links</p>
      <h1>Recent links and references.</h1>
      <p class="page-shell__intro">
        A running collection of the things we have been sharing publicly.
      </p>
    </section>

    <section class="wrapper page-shell__section">
      <div class="page-shell__section-heading">
        <p class="page-shell__kicker">Feed</p>
        <h2>Latest shared links.</h2>
      </div>

      <ul role="list" class="page-grid">
        {
          [
            ...data.records.filter((link: any) => link.fields.Pinned === true),
            ...data.records.filter((link: any) => link.fields.Pinned !== true),
          ].map((link: any) => (
            <Card
              name={link.fields.Name}
              description={link.fields.Description}
              link={link.fields.Link}
            />
          ))
        }
      </ul>
    </section>
  </main>
</Layout>
