---
import Layout from "@layouts/Layout.astro";
import Card from "~/components/Card.astro";
const response = await fetch(
  `https://api.airtable.com/v0/${import.meta.env.DB_ID}/Projects`,
  {
    headers: {
      Authorization: `Bearer ${import.meta.env.DB_TOKEN}`,
    },
  }
);
const data = await response.json();
console.log(data.records[0].fields);
---

<Layout title={"Archive"}>
  <main class="page-shell">
    <section class="wrapper page-shell__hero">
      <p class="page-shell__kicker">Archive</p>
      <h1>The Radical Data Archive.</h1>
      <p class="page-shell__intro">
        References, experiments and projects from beyond Radical Data: queer
        data, tech feminista, activist maps, community infrastructures and
        digital resistance.
      </p>
    </section>

    <section class="wrapper page-shell__section">
      <div class="page-shell__section-heading">
        <p class="page-shell__kicker">Explore</p>
        <h2>Archive entries.</h2>
      </div>

      <ul role="list" class="page-grid">
        {
          data.records.map((project: any) => (
            <Card
              name={project.fields.Name}
              description={project.fields.Summary}
              image={project.fields["Featured Image"]}
              theme={project.fields.Theme}
              link={`/projects/${project.fields.Slug}`}
            />
          ))
        }
      </ul>
    </section>
  </main>
</Layout>
