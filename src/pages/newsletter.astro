---
import MailingList from "~/components/MailingList.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Newsletter | Radical Data">
  <main class="page-shell">
    <section class="wrapper page-shell__hero">
      <p class="page-shell__kicker">Newsletter</p>
      <h1>Stay close to what we are building.</h1>
      <p class="page-shell__intro">
        Projects, workshops, writing, tools and references from across Radical
        Data. In your inbox, once a month.
      </p>
    </section>

    <section class="wrapper page-shell__section">
      <div class="page-shell__section-heading">
        <p class="page-shell__kicker">Subscribe</p>
        <h2>Join the mailing list.</h2>
      </div>

      <div class="page-panel">
        <MailingList />
      </div>
    </section>
  </main>
</Layout>
