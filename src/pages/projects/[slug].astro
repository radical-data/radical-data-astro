---
import Layout from "@layouts/Layout.astro";
import { getRelatedPosts } from "../../lib/getRelatedPosts";
import { marked } from "marked";
import sanitizeHtml from "sanitize-html";
import Card from "~/components/Card.astro";
import Tag from "~/components/Tag.astro";
import { getThemeMeta, isTheme } from "~/lib/themes";

export async function getStaticPaths() {
  async function fetchAllProjects(view: string) {
    const records = [];
    let offset: string | undefined;

    do {
      const url = new URL(
        `https://api.airtable.com/v0/${import.meta.env.DB_ID}/Projects`
      );
      url.searchParams.set("view", view);

      if (offset) {
        url.searchParams.set("offset", offset);
      }

      const response = await fetch(url.toString(), {
        headers: {
          Authorization: `Bearer ${import.meta.env.DB_TOKEN}`,
        },
      });

      if (!response.ok) {
        throw new Error(`Failed to fetch Airtable view: ${view}`);
      }

      const data = await response.json();
      records.push(...(data.records ?? []));
      offset = data.offset;
    } while (offset);

    return records;
  }

  const records = await fetchAllProjects("Grid view");

  return records
    .filter((project: any) => {
      const slug = project?.fields?.Slug;
      return typeof slug === "string" && slug.trim().length > 0;
    })
    .map((project: any) => {
      return {
        params: { slug: project.fields.Slug },
        props: {
          fields: project.fields,
          relatedPosts: getRelatedPosts(records, project, 6),
        },
      };
    });
}

const { slug } = Astro.params;
slug;

const { fields, relatedPosts } = Astro.props;

const whatItIs = fields["What It Is"];
const howItWorks = fields["How It Works"];
const whyItMatters = fields["Why It Matters"];

const themeName = isTheme(fields["Theme"]) ? fields["Theme"] : undefined;
const themeMeta = themeName ? getThemeMeta(themeName) : undefined;

const hasStructuredSections = Boolean(
  whatItIs || howItWorks || whyItMatters
);

function renderRichText(content: string) {
  return sanitizeHtml(marked.parse(content));
}

console.log(fields);
---

<Layout title={fields.Name}>
  <main>
    <article class="region prose wrapper">
      <h1>{fields.Name}</h1>
      {
        themeName && themeMeta && (
          <aside class={`project-theme project-theme--${themeMeta.slug}`}>
            <p class="project-theme__eyebrow">Theme</p>
            <h2>{themeName}</h2>
            <p>{themeMeta.description}</p>
            <p class="project-theme__link">
              <a href="/#themes">
                Browse all theme-led work on the homepage
              </a>
            </p>
          </aside>
        )
      }

      {fields["Summary"] && <h2>{fields.Summary}</h2>}
      {
        fields["Featured Image"] && (
          <img
            src={fields["Featured Image"][0].url}
            alt=""
            loading="lazy"
            style="max-width: 100%; height: auto;"
          />
        )
      }
      {
        fields["Tags"] && (
          <>
            <ul>
              {fields.Tags.map((tag: string) => (
                <Tag tag={tag} />
              ))}
            </ul>
          </>
        )
      }
      {
        hasStructuredSections ? (
          <div class="content flow">
            {
              whatItIs && (
                <section class="project-section flow">
                  <h2>What It Is</h2>
                  <div set:html={renderRichText(whatItIs)} />
                </section>
              )
            }

            {
              howItWorks && (
                <section class="project-section flow">
                  <h2>How It Works</h2>
                  <div set:html={renderRichText(howItWorks)} />
                </section>
              )
            }

            {
              whyItMatters && (
                <section class="project-section flow">
                  <h2>Why It Matters</h2>
                  <div set:html={renderRichText(whyItMatters)} />
                </section>
              )
            }
          </div>
        ) : (
          fields["Content"] && (
            <div class="content" set:html={renderRichText(fields["Content"])} />
          )
        )
      }
      {
        fields["Attribution"] && (
          <p>
            <i>{fields.Attribution}</i>
          </p>
        )
      }
      <h2>Similar projects to {fields.Name}</h2>
      <ul>
        {
          relatedPosts.map((project: any) => (
            <Card
              name={project.fields.Name}
              description={project.fields.Summary}
              image={project.fields["Featured Image"]}
              theme={project.fields.Theme}
              link={`/projects/${project.fields.Slug}`}
            />
          ))
        }
      </ul>
      <p>
        Back to <a href={`/projects`}>all projects</a>.
      </p>
    </article>
  </main>
</Layout>

<style>
  .project-theme {
    margin-bottom: 1.5rem;
    border: 2px solid #111;
    padding: 1rem;
    box-shadow: 0.35rem 0.35rem 0 #111;
    color: #111;
  }

  .project-theme--collective-intelligence {
    background: #ffe500;
  }

  .project-theme--tools-for-postcapitalism {
    background: #ff5b4d;
    color: white;
  }

  .project-theme--tecnologia-popular {
    background: #204cff;
    color: white;
  }

  .project-theme :global(h2) {
    margin: 0.15rem 0 0.5rem;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    max-width: 14ch;
  }

  .project-theme__eyebrow {
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .project-theme p {
    max-width: 36rem;
  }

  .project-theme__link {
    margin-top: 0.85rem;
  }

  .project-theme__link a {
    color: inherit;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
  }
</style>