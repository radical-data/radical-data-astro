---
import Layout from "@layouts/Layout.astro";
import { getRelatedPosts } from "../../lib/getRelatedPosts";
import { marked } from "marked";
import sanitizeHtml from "sanitize-html";
import Card from "~/components/Card.astro";
import Tag from "~/components/Tag.astro";
import { getThemeMeta, isTheme } from "~/lib/themes";

export async function getStaticPaths() {
  async function fetchAllRecords(table: string, view?: string) {
    const records = [];
    let offset: string | undefined;

    do {
      const url = new URL(
        `https://api.airtable.com/v0/${import.meta.env.DB_ID}/${encodeURIComponent(table)}`
      );

      if (view) {
        url.searchParams.set("view", view);
      }

      if (offset) {
        url.searchParams.set("offset", offset);
      }

      const response = await fetch(url.toString(), {
        headers: {
          Authorization: `Bearer ${import.meta.env.DB_TOKEN}`,
        },
      });

      if (!response.ok) {
        throw new Error(
          `Failed to fetch Airtable table: ${table}${view ? ` (view: ${view})` : ""}`
        );
      }

      const data = await response.json();
      records.push(...(data.records ?? []));
      offset = data.offset;
    } while (offset);

    return records;
  }

  function sortProjectLinks(
    a: { title: string; url: string; isHomepage: boolean },
    b: { title: string; url: string; isHomepage: boolean }
  ) {
    if (a.isHomepage !== b.isHomepage) {
      return a.isHomepage ? -1 : 1;
    }

    const aHasTitle = a.title.trim().length > 0;
    const bHasTitle = b.title.trim().length > 0;

    if (aHasTitle !== bHasTitle) {
      return aHasTitle ? -1 : 1;
    }

    return a.url.localeCompare(b.url);
  }

  const [projectRecords, furtherReadingRecords] = await Promise.all([
    fetchAllRecords("Projects", "Grid view"),
    fetchAllRecords("Further Readings", "Grid view"),
  ]);

  const furtherReadingsByProjectId = new Map<
    string,
    { title: string; url: string; isHomepage: boolean }[]
  >();

  for (const reading of furtherReadingRecords) {
    const fields = reading?.fields ?? {};
    const url = typeof fields["Link"] === "string" ? fields["Link"].trim() : "";
    const title =
      typeof fields["Title"] === "string" ? fields["Title"].trim() : "";
    const linkedProjects = Array.isArray(fields["Projects"])
      ? fields["Projects"]
      : [];
    const isHomepage = fields["Project Homepage"] === true;

    if (!url) continue;

    for (const projectId of linkedProjects) {
      const existing = furtherReadingsByProjectId.get(projectId) ?? [];
      existing.push({ title, url, isHomepage });
      furtherReadingsByProjectId.set(projectId, existing);
    }
  }

  return projectRecords
    .filter((project: any) => {
      const slug = project?.fields?.Slug;
      return typeof slug === "string" && slug.trim().length > 0;
    })
    .map((project: any) => {
      const rawFurtherReadings = furtherReadingsByProjectId.get(project.id) ?? [];
      const dedupedFurtherReadings = rawFurtherReadings.filter(
        (reading, index, array) =>
          array.findIndex((item) => item.url === reading.url) === index
      ).sort(sortProjectLinks);

      return {
        params: { slug: project.fields.Slug },
        props: {
          fields: project.fields,
          relatedPosts: getRelatedPosts(projectRecords, project, 6),
          projectLinks: dedupedFurtherReadings,
        },
      };
    });
}

const { slug } = Astro.params;
slug;

const { fields, relatedPosts, projectLinks = [] } = Astro.props;

const whatItIs = fields["What It Is"];
const howItWorks = fields["How It Works"];
const whyItMatters = fields["Why It Matters"];

const themeName = isTheme(fields["Theme"]) ? fields["Theme"] : undefined;
const themeMeta = themeName ? getThemeMeta(themeName) : undefined;

const hasStructuredSections = Boolean(
  whatItIs || howItWorks || whyItMatters
);

function renderRichText(content: string) {
  return sanitizeHtml(marked.parse(content));
}

function getLinkLabel(link: { title?: string; url: string; isHomepage?: boolean }) {
  if (link.title && link.title.trim().length > 0) {
    return link.title.trim();
  }

  try {
    const { hostname } = new URL(link.url);
    return link.isHomepage ? "Visit project website" : hostname.replace(/^www\./, "");
  } catch {
    return link.isHomepage ? "Visit project website" : link.url;
  }
}

console.log(fields);
---

<Layout title={fields.Name}>
  <main class="page-shell">
    <section class="wrapper page-shell__hero">
      <p class="page-shell__kicker">Project</p>
      <h1>{fields.Name}</h1>
      {fields["Summary"] && <p class="page-shell__intro">{fields.Summary}</p>}
    </section>

    <section class="wrapper page-shell__section">
      {
        themeName && themeMeta && (
          <aside class={`project-theme page-panel theme-surface--${themeMeta.slug}`}>
            <p class="project-theme__eyebrow">Theme</p>
            <h2>{themeName}</h2>
            <p>{themeMeta.description}</p>
            <p class="project-theme__link">
              <a href="/#themes">
                Browse all theme-led work on the homepage
              </a>
            </p>
          </aside>
        )
      }

      {
        projectLinks.length > 0 && (
          <section class="project-links page-panel flow" aria-labelledby="project-links-title">
            <h2 id="project-links-title">Project links</h2>
            <ul role="list" class="project-links__list">
              {projectLinks.map((link: { title?: string; url: string; isHomepage?: boolean }) => (
                <li>
                  <a href={link.url} target="_blank" rel="noreferrer noopener">
                    {getLinkLabel(link)}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        fields["Featured Image"] && (
          <figure class="project-image">
            <img
              src={fields["Featured Image"][0].url}
              alt=""
              loading="lazy"
            />
          </figure>
        )
      }

      {
        fields["Tags"] && (
          <ul role="list" class="project-tags">
            {fields.Tags.map((tag: string) => (
              <li>
                <Tag tag={tag} />
              </li>
            ))}
          </ul>
        )
      }

      {
        hasStructuredSections ? (
          <div class="rich-content flow">
            {
              whatItIs && (
                <section class="project-section page-panel flow">
                  <h2>What It Is</h2>
                  <div set:html={renderRichText(whatItIs)} />
                </section>
              )
            }

            {
              howItWorks && (
                <section class="project-section page-panel flow">
                  <h2>How It Works</h2>
                  <div set:html={renderRichText(howItWorks)} />
                </section>
              )
            }

            {
              whyItMatters && (
                <section class="project-section page-panel flow">
                  <h2>Why It Matters</h2>
                  <div set:html={renderRichText(whyItMatters)} />
                </section>
              )
            }
          </div>
        ) : (
          fields["Content"] && (
            <div
              class="rich-content page-panel"
              set:html={renderRichText(fields["Content"])}
            />
          )
        )
      }

      {
        fields["Attribution"] && (
          <p class="project-attribution">
            <i>{fields.Attribution}</i>
          </p>
        )
      }
    </section>

    {
      relatedPosts.length > 0 && (
        <section class="wrapper page-shell__section">
          <div class="page-shell__section-heading">
            <p class="page-shell__kicker">Related</p>
            <h2>Similar projects to {fields.Name}.</h2>
          </div>

          <ul role="list" class="page-grid">
            {
              relatedPosts.map((project: any) => (
                <Card
                  name={project.fields.Name}
                  description={project.fields.Summary}
                  image={project.fields["Featured Image"]}
                  theme={project.fields.Theme}
                  link={`/projects/${project.fields.Slug}`}
                />
              ))
            }
          </ul>

          <p class="project-backlink">
            <a href="/projects/" class="button-link">Back to all projects</a>
          </p>
        </section>
      )
    }
  </main>
</Layout>

<style>
  .project-theme {
    margin-bottom: 1.5rem;
  }

  .project-theme :global(h2) {
    margin: 0.15rem 0 0.5rem;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    max-width: 14ch;
  }

  .project-theme__eyebrow {
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .project-theme p {
    max-width: 36rem;
  }

  .project-theme__link {
    margin-top: 0.85rem;
  }

  .project-theme__link a {
    color: inherit;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
  }

  .project-image {
    margin-bottom: 1.5rem;
  }

  .project-image img {
    width: 100%;
    height: auto;
    border: 2px solid #111;
    box-shadow: 0.35rem 0.35rem 0 #111;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    margin: 0 0 1.5rem 0;
    list-style: none;
  }

  .project-links {
    margin-bottom: 1.5rem;
  }

  .project-links h2 {
    font-size: clamp(1.7rem, 4vw, 2.8rem);
    line-height: 0.94;
    font-weight: 900;
    text-transform: uppercase;
  }

  .project-links__list {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .project-links__list a {
    font-weight: 800;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
  }

  .project-section + .project-section {
    margin-top: 1rem;
  }

  .project-section h2 {
    font-size: clamp(1.7rem, 4vw, 2.8rem);
    line-height: 0.94;
    font-weight: 900;
    text-transform: uppercase;
  }

  .project-attribution {
    margin-top: 1.25rem;
    font-size: 0.95rem;
  }

  .project-backlink {
    margin-top: 1.5rem;
  }
</style>