---
import Icon, { type Props as IconProps } from "./Icon.astro";
import { SOCIAL, SOCIAL_FOR_NAV } from "~/config/social";

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
  { label: "Projects", href: "/projects/" },
  { label: "Archive", href: "/archive/" },
  { label: "About", href: "/about/" },
];

// Helper to get platform name for screen reader text
function getPlatformLabel(entry: typeof SOCIAL_FOR_NAV[number]): string {
  const platformKey = Object.entries(SOCIAL).find(
    ([_, social]) => social === entry
  )?.[0];
  if (!platformKey) return "Social media";
  return platformKey.charAt(0).toUpperCase() + platformKey.slice(1);
}
---

<nav>
  <div class="menu-header">
    <a href="/" class="site-title" aria-label="Radical Data home">
      <img src="/radical-data-logo.svg" alt="Radical Data" class="site-title__logo" />
    </a>
    <menu-button>
      <template>
        <button class="menu-button" aria-expanded="false">
          <span class="sr-only">Menu</span>
          <Icon icon="list" />
        </button>
      </template>
    </menu-button>
  </div>
  <div id="menu-content">
    <ul class="nav-items">
      {
        textLinks.map(({ label, href }) => (
          <li>
            <a
              aria-current={Astro.url.pathname === href}
              class:list={[
                "link",
                {
                  active:
                    Astro.url.pathname === href ||
                    (href !== "/" && Astro.url.pathname.startsWith(href)),
                },
              ]}
              href={href}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu-footer">
      <div class="socials">
        {
          SOCIAL_FOR_NAV.map((entry) => (
            <a href={entry.url} class="social">
              <span class="sr-only">{getPlatformLabel(entry)}</span>
              <Icon icon={entry.icon as IconProps["icon"]} />
            </a>
          ))
        }
      </div>

    </div>
  </div>
</nav>

<script>
  class MenuButton extends HTMLElement {
    constructor() {
      super();

      // Inject menu toggle button when JS runs.
      this.appendChild(this.querySelector("template")!.content.cloneNode(true));
      const btn = this.querySelector("button")!;

      // Hide menu (shown by default to support no-JS browsers).
      const menu = document.getElementById("menu-content")!;
      menu.hidden = true;

      /** Set whether the menu is currently expanded or collapsed. */
      const setExpanded = (expand: boolean) => {
        btn.setAttribute("aria-expanded", expand ? "true" : "false");
        menu.hidden = !expand;
      };

      // Toggle menu visibility when the menu button is clicked.
      btn.addEventListener("click", () => setExpanded(menu.hidden));

      // Hide menu button for large screens.
      const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
        setExpanded(e.matches);
        btn.hidden = e.matches;
      };
      const mediaQueries = window.matchMedia("(min-width: 50em)");
      handleViewports(mediaQueries);
      mediaQueries.addEventListener("change", handleViewports);
    }
  }
  customElements.define("menu-button", MenuButton);
</script>

<style>
  nav {
    z-index: 9999;
    position: relative;
    background: #f5f5f2;
    border-bottom: 2px solid #111;
  }

  .menu-header {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem;
    align-items: start;
  }

  .site-title {
    display: flex;
    align-items: center;
    color: #111;
    text-decoration: none;
    min-width: 0;
  }

  .site-title__logo {
    display: block;
    width: clamp(7rem, 11vw, 10rem);
    height: auto;
    max-width: 100%;
  }

  .menu-button {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #111;
    padding: 0.6rem;
    color: #111;
    background: #fff;
    box-shadow: 0.25rem 0.25rem 0 #111;
  }

  .menu-button[aria-expanded="true"] {
    transform: translate(-0.12rem, -0.12rem);
  }

  .menu-button[hidden] {
    display: none;
  }

  #menu-content {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% - 0.25rem);
    padding-inline: 1rem;
  }

  .nav-items {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    line-height: 1;
    list-style: none;
    padding: 0;
    background: #f3f0e8;
    border: 2px solid #111;
    box-shadow: 0.35rem 0.35rem 0 #111;
  }

  .link {
    display: block;
    color: #111;
    text-decoration: none;
    padding: 1rem;
    font-size: clamp(1.2rem, 3vw, 1.9rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    border-bottom: 2px solid #111;
  }

  .nav-items li:last-child .link {
    border-bottom: 0;
  }

  .link:hover,
  .link:focus {
    background: #fff;
  }

  .link.active {
    background: #204cff;
    color: white;
  }

  .menu-footer {
    display: flex;
    justify-content: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem 0 1rem;
    background: #f5f5f2;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid #111;
    background: #fff;
    text-decoration: none;
    color: #111;
    box-shadow: 0.2rem 0.2rem 0 #111;
  }

  .social:hover,
  .social:focus {
    transform: translate(-0.08rem, -0.08rem);
  }

  @media (min-width: 50em) {
    nav {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 2rem;
      padding: 1.25rem 1.5rem 0 1.5rem;
    }

    .menu-header {
      padding: 0;
      flex: 0 0 auto;
    }

    #menu-content {
      position: static;
      padding: 0;
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }

    .nav-items {
      flex-direction: row;
      align-items: stretch;
      box-shadow: 0.35rem 0.35rem 0 #111;
    }

    .link {
      padding: 0.9rem 1.05rem;
      border-bottom: 0;
      border-right: 2px solid #111;
      font-size: 0.95rem;
    }

    .nav-items li:last-child .link {
      border-right: 0;
    }

    .menu-footer {
      padding: 0;
      display: flex;
      background: transparent;
    }
  }
</style>
