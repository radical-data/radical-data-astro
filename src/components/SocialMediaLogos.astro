---
import instagramLogo from "@assets/media/instagram.svg";
import twitterLogo from "@assets/media/twitter.svg";
import youtubeLogo from "@assets/media/youtube.svg";
import linkedinLogo from "@assets/media/linkedin.svg";
import tiktokLogo from "@assets/media/tiktok.svg";
import githubLogo from "@assets/media/github.svg";

import { SOCIAL, SOCIAL_FOR_FOOTER } from "~/config/social";

// Optional: a small mapping function from platform to asset.
// This keeps all asset imports here, but still uses the config as data source.
const logoMap: Record<string, { src: string; alt: string }> = {
  instagram: { src: instagramLogo.src, alt: "Instagram logo" },
  twitter: { src: twitterLogo.src, alt: "Twitter logo" },
  youtube: { src: youtubeLogo.src, alt: "YouTube logo" },
  linkedin: { src: linkedinLogo.src, alt: "LinkedIn logo" },
  tiktok: { src: tiktokLogo.src, alt: "TikTok logo" },
  github: { src: githubLogo.src, alt: "GitHub logo" },
};
---

<ul class="social-media-icons">
  {
    SOCIAL_FOR_FOOTER.map((entry) => {
      // Find the platform key by matching the entry
      const platformKey = Object.entries(SOCIAL).find(
        ([_, social]) => social === entry
      )?.[0];
      if (!platformKey) return null;
      const logo = logoMap[platformKey];
      if (!logo) return null;
      return (
        <li>
          <a href={entry.url}>
            <img src={logo.src} alt={logo.alt} />
          </a>
        </li>
      );
    })
  }
</ul>
<style>
  ul {
    list-style: none;
    list-style-type: none;
  }

  ul {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    width: clamp(50%, 20em, 100%);
    margin: 0;
    padding: 0;
  }
  li {
    display: block;
    flex: 0 1 auto;
    list-style-type: none;
  }

  .social-media-icons {
    display: flex;
    justify-self: center;
    align-items: center;
    align-self: center;
  }

  li {
    width: 10%;
  }

  img {
    max-width: 100%;
    width: 50rem;
  }

  .social-media-icons img {
    animation-name: rotation;
    /* animation-duration: 0.016666666666s; */
    animation-duration: 150s;
    /* animation-iteration-count: infinite; */
    animation-fill-mode: forwards;
    animation-timing-function: linear;
  }

  @keyframes rotation {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(180deg);
    }
  }

  @keyframes rotation-backwards {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-180deg);
    }
  }

  .social-media-icons > li:nth-child(1) > * > img {
    animation-duration: 150s;
  }

  .social-media-icons > li:nth-child(2) > * > img {
    animation-duration: 100s;
    animation-name: rotation-backwards;
  }

  .social-media-icons > li:nth-child(3) > * > img {
    animation-duration: 600s;
  }

  .social-media-icons > li:nth-child(4) > * > img {
    animation-duration: 120s;
  }

  .social-media-icons > li:nth-child(5) > * > img {
    animation-duration: 185s;
    animation-name: rotation-backwards;
  }

  .social-media-icons > li:nth-child(6) > * > img {
    animation-duration: 300s;
  }

  .social-media-icons > li:nth-child(7) > * > img {
    animation-duration: 700s;
    animation-name: rotation-backwards;
  }
</style>
