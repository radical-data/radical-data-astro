---
import { getThemeMeta, isTheme } from "~/lib/themes";

const { name, description, link, theme } = Astro.props;
const themeName = isTheme(theme) ? theme : undefined;
const themeMeta = themeName ? getThemeMeta(themeName) : undefined;
---

<div class="card">
  <a href={link} class="card__link">
    {
      themeName && themeMeta && (
        <p class={`theme-pill theme-pill--${themeMeta.slug}`}>
          {themeName}
        </p>
      )
    }
    <p class="card__eyebrow">Project</p>
    <h2>{name}</h2>
    <p class="card__summary">
      {
        description
          ? description.endsWith(".")
            ? description
            : `${description}.`
          : ""
      }
    </p>
  </a>
</div>

<style>
  .card {
    list-style: none;
  }

  .card__link {
    display: grid;
    gap: 0.65rem;
    min-height: 15rem;
    padding: 1rem;
    border: 2px solid #111;
    background: #fff;
    color: #111;
    text-decoration: none;
    box-shadow: 0.35rem 0.35rem 0 #111;
  }

  .card__link:hover,
  .card__link:focus {
    transform: translate(-0.12rem, -0.12rem);
    text-decoration: none;
  }

  .card__eyebrow {
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgb(17 17 17 / 0.72);
  }

  .card h2 {
    padding: 0;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    line-height: 0.95;
    font-weight: 900;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .card__summary {
    max-width: 28ch;
    font-size: 0.95rem;
    line-height: 1.14;
  }

  :global(.card .theme-pill) {
    margin-bottom: 0;
  }

  @media (prefers-contrast: more) {
    .card__link,
    :global(.card .theme-pill) {
      box-shadow: none;
    }
  }
</style>
